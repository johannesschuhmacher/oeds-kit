          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT run_id FROM price_forecast.forecast_runs WHERE market_area = '$Market_Area' AND variant = 'day_ahead' AND status = 'completed' ORDER BY created_at DESC LIMIT 1) SELECT delivery_start_utc AS time, 'point' AS metric, value_eur_mwh AS value FROM price_forecast.point_forecasts WHERE run_id = (SELECT run_id FROM latest) UNION ALL SELECT delivery_start_utc AS time, 'q' || quantile::text AS metric, value_eur_mwh AS value FROM price_forecast.quantile_forecasts WHERE run_id = (SELECT run_id FROM latest) AND quantile IN (0.1, 0.5, 0.9) ORDER BY 1, 2",
