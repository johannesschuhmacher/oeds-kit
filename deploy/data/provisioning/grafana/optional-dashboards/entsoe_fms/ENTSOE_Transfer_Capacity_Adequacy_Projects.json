        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nWITH latest AS (\n  SELECT MAX(\"DateTime(UTC)\") AS ts\n  FROM entsoe_fms.\"UseOfTransferCapacity\"\n  WHERE (\"OutAreaDisplayName\" || ' -> ' || \"InAreaDisplayName\") = '$Border'\n    AND \"ContractType\" = '$Contract_Type'\n)\nSELECT ROUND((100.0 * SUM(u.\"AllocatedCapacity[MW]\") / NULLIF(SUM(u.\"RequestedCapacity[MW]\"), 0))::numeric, 1) AS value\nFROM entsoe_fms.\"UseOfTransferCapacity\" u\nJOIN latest l ON u.\"DateTime(UTC)\" = l.ts\nWHERE (u.\"OutAreaDisplayName\" || ' -> ' || u.\"InAreaDisplayName\") = '$Border'\n  AND u.\"ContractType\" = '$Contract_Type';\n",
          "refId": "A"
        }
      ],
