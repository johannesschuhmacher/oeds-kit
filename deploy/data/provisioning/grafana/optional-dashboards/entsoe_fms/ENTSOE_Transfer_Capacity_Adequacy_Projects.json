          "rawSql": "\nSELECT\n  \"DateTime(UTC)\" AS \"time\",\n  'Allocated' AS metric,\n  SUM(\"AllocatedCapacity[MW]\") AS value\nFROM entsoe_fms.\"UseOfTransferCapacity\"\nWHERE $__timeFilter(\"DateTime(UTC)\")\n  AND (\"OutAreaDisplayName\" || ' -> ' || \"InAreaDisplayName\") = '$Border'\n  AND \"ContractType\" = '$Contract_Type'\nGROUP BY 1\nUNION ALL\nSELECT\n  \"DateTime(UTC)\" AS \"time\",\n  'Requested' AS metric,\n  SUM(\"RequestedCapacity[MW]\") AS value\nFROM entsoe_fms.\"UseOfTransferCapacity\"\nWHERE $__timeFilter(\"DateTime(UTC)\")\n  AND (\"OutAreaDisplayName\" || ' -> ' || \"InAreaDisplayName\") = '$Border'\n  AND \"ContractType\" = '$Contract_Type'\nGROUP BY 1\nORDER BY 1;\n",
