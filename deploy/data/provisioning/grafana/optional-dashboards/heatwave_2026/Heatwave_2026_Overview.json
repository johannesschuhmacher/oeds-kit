          "rawQuery": true,
          "rawSql": "SELECT label,\n       nuclear_drop_avg_mw / 1000.0 AS nuclear_drop_gw,\n       fossil_increase_avg_mw / 1000.0 AS fossil_increase_gw,\n       -fossil_drop_avg_mw / 1000.0 AS fossil_drop_gw\nFROM heatwave_2026.replacement_metrics\nWHERE COALESCE(nuclear_drop_avg_mw, 0) > 50\n   OR COALESCE(fossil_increase_avg_mw, 0) > 50\n   OR COALESCE(fossil_drop_avg_mw, 0) > 50\nORDER BY (COALESCE(nuclear_drop_avg_mw, 0) + COALESCE(fossil_increase_avg_mw, 0) + 0.35 * COALESCE(fossil_drop_avg_mw, 0)) DESC\nLIMIT 10",
