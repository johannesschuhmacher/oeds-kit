          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, country AS metric, avg(price_eur_mwh) AS value\nFROM heatwave_2026.prices_qh\nWHERE $__timeFilter(timestamp)\n  AND country IN ('FR','DE_LU','BE','NL','CH','IT_NORD','ES','HU')\nGROUP BY 1, 2\nORDER BY 1, 2",
