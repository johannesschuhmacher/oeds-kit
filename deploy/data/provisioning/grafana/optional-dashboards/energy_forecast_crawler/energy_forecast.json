          "editorMode": "code", "format": "time_series", "rawQuery": true,
          "rawSql": "SELECT prediction_start AS time, p_h_00_m_00 * 1000 AS \"Actual Price\" FROM energy_forecast.predictions_48h WHERE $__timeFilter(prediction_start) ORDER BY prediction_start",
