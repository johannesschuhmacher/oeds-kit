          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '1d'), avg(\"$Country\") AS \"Solar PV\" FROM ninja.capacity_solar_merra2 WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
