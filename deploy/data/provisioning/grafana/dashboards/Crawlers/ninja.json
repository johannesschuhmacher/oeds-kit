          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '1d'), avg(\"$Country\") AS \"Wind onshore\" FROM ninja.capacity_wind_on WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        },
