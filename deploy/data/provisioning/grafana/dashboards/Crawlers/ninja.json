    {
      "type": "barchart",
      "title": "Seasonal profile, all years",
      "description": "Monthly mean over the whole data period, independent of the selected time range.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(make_date(2000, m, 1), 'Mon') AS month, wind AS \"Wind onshore\", solar AS \"Solar PV\" FROM (SELECT extract(month FROM time)::int AS m, avg(\"$Country\") AS wind FROM ninja.capacity_wind_on GROUP BY 1) w JOIN (SELECT extract(month FROM time)::int AS m, avg(\"$Country\") AS solar FROM ninja.capacity_solar_merra2 GROUP BY 1) s USING (m) ORDER BY m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
