    {
      "type": "barchart",
      "title": "Mean capacity factor by country (selected period)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH won AS (SELECT key AS country, avg(value::float) AS v FROM ninja.capacity_wind_on t, jsonb_each_text(to_jsonb(t) - 'time' - 'index') WHERE $__timeFilter(time) GROUP BY 1), woff AS (SELECT key AS country, avg(value::float) AS v FROM ninja.capacity_wind_off t, jsonb_each_text(to_jsonb(t) - 'time' - 'index') WHERE $__timeFilter(time) GROUP BY 1), pv AS (SELECT key AS country, avg(value::float) AS v FROM ninja.capacity_solar_merra2 t, jsonb_each_text(to_jsonb(t) - 'time' - 'index') WHERE $__timeFilter(time) GROUP BY 1) SELECT upper(country) AS country, won.v AS \"Wind onshore\", woff.v AS \"Wind offshore\", pv.v AS \"Solar PV\" FROM won FULL JOIN woff USING (country) FULL JOIN pv USING (country) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
