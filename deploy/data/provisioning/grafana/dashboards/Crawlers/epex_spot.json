          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Continuous indices' AS dataset, min(delivery_start_utc) AS first_delivery, max(delivery_start_utc) AS last_delivery, max(download_time_utc) AS last_download FROM epex_spot.continuous_indices UNION ALL SELECT 'Continuous statistics', min(delivery_start_utc), max(delivery_start_utc), max(download_time_utc) FROM epex_spot.continuous_statistics UNION ALL SELECT 'Intraday auctions', min(delivery_start_utc), max(delivery_start_utc), max(download_time_utc) FROM epex_spot.intraday_auction_prices_volumes UNION ALL SELECT 'Continuous trades', min(delivery_start_utc), max(delivery_start_utc), (SELECT max(imported_at) FROM epex_spot.imported_files) FROM epex_spot.continuous_trades"
        }
      ],
