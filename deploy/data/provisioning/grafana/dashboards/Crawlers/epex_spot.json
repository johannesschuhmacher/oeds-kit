    {
      "type": "timeseries",
      "title": "Trades per delivery hour: volume (MWh) and VWAP (EUR/MWh)",
      "description": "Aggregated from the individual continuous trades (all products), MWh. A trade between two German participants appears once per side.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', delivery_start_utc) AS time, sum(volume) FILTER (WHERE side = 'BUY') AS \"Bought by DE participants\", sum(volume) FILTER (WHERE side = 'SELL') AS \"Sold by DE participants\", sum(price * volume) / nullif(sum(volume), 0) AS \"VWAP\" FROM epex_spot.continuous_trades WHERE $__timeFilter(delivery_start_utc) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VWAP"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
