          "rawSql": "SELECT name, fuel_type AS fuel, nullif(technology, 'NaN') AS technology, nullif(set_type, 'NaN') AS \"set type\", round(capacity::numeric) AS \"capacity (MW)\", nullif(date_in, 'NaN')::int AS commissioned, nullif(date_retrofit, 'NaN')::int AS retrofit, nullif(date_out, 'NaN')::int AS \"planned closure\" FROM power_system_data.powersystemdata WHERE country = '$Country' AND capacity <> 'NaN' AND (date_out = 'NaN' OR date_out > extract(year FROM now())) AND (date_in = 'NaN' OR date_in <= extract(year FROM now())) ORDER BY capacity DESC LIMIT 50"
