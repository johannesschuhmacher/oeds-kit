          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 0 AS time, lat, lon, name, fuel_type AS fuel, nullif(technology, 'NaN') AS technology, capacity AS capacity_mw, nullif(date_in, 'NaN')::int AS commissioned FROM power_system_data.powersystemdata WHERE country = '$Country' AND capacity <> 'NaN' AND (date_out = 'NaN' OR date_out > extract(year FROM now())) AND (date_in = 'NaN' OR date_in <= extract(year FROM now())) AND capacity >= $MinCapacity AND lat <> 'NaN' AND lon <> 'NaN' ORDER BY capacity DESC LIMIT 5000"
        }
      ],
