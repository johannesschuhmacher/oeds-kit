          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT decade, fuel_type, capacity FROM ( SELECT (floor(date_in / 10) * 10)::int AS d, (floor(date_in / 10) * 10)::int::text || 's' AS decade, fuel_type, sum(capacity) * 1e6 AS capacity FROM power_system_data.powersystemdata WHERE country = '$Country' AND capacity <> 'NaN' AND (date_out = 'NaN' OR date_out > extract(year FROM now())) AND (date_in = 'NaN' OR date_in <= extract(year FROM now())) AND date_in <> 'NaN' GROUP BY 1, 2, 3) x ORDER BY d"
