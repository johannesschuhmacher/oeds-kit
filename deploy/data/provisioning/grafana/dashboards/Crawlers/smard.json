          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp,$__interval), CASE commodity_id WHEN '410' THEN 'Total load' WHEN '4066' THEN 'Biomass' WHEN '1226' THEN 'Hydropower' WHEN '1225' THEN 'Wind offshore' WHEN '4067' THEN 'Wind onshore' WHEN '4068' THEN 'Solar' WHEN '1228' THEN 'Other renewables' WHEN '1223' THEN 'Lignite' WHEN '4071' THEN 'Natural gas' WHEN '4070' THEN 'Pumped storage' WHEN '1227' THEN 'Other conventional' WHEN '4069' THEN 'Hard coal' END AS metric, avg(mwh*4) AS power_mw FROM smard.smard WHERE $__timeFilter(timestamp) GROUP BY 1,2 ORDER BY 1,2",
