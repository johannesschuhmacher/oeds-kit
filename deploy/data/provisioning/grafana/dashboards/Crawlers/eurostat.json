    {
      "type": "table",
      "title": "Country comparison, latest year (MW)",
      "description": "EU27_2020 and EA21 are the EU and euro-area totals.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"geo\\TIME_PERIOD\" AS country, round(sum(capacity) FILTER (WHERE siec = 'RA310')) AS \"Wind onshore\", round(sum(capacity) FILTER (WHERE siec = 'RA320')) AS \"Wind offshore\", round(sum(capacity) FILTER (WHERE siec = 'RA420')) AS \"Solar PV\", round(sum(capacity) FILTER (WHERE siec IN ('RA110', 'RA120'))) AS \"Hydro excl. pumped\", round(sum(capacity) FILTER (WHERE siec = 'RA130')) AS \"Pumped hydro\", round(sum(capacity) FILTER (WHERE siec IN ('R5100', 'R5290', 'R5300'))) AS \"Bioenergy\" FROM eurostat.eurostat WHERE plant_tec = 'CAP_NET_ELC' AND year = (SELECT max(year) FROM eurostat.eurostat) GROUP BY 1 ORDER BY 4 DESC NULLS LAST"
        }
      ],
