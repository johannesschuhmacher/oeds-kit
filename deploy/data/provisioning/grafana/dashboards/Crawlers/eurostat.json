    {
      "type": "barchart",
      "title": "Capacity by technology and year",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P6EAA63344BCC9F38"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT year::text AS year, sum(capacity) FILTER (WHERE siec = 'RA310') * 1e6 AS \"Wind onshore\", sum(capacity) FILTER (WHERE siec = 'RA320') * 1e6 AS \"Wind offshore\", sum(capacity) FILTER (WHERE siec = 'RA420') * 1e6 AS \"Solar photovoltaic\", sum(capacity) FILTER (WHERE siec = 'RA410') * 1e6 AS \"Solar thermal\", sum(capacity) FILTER (WHERE siec = 'RA110') * 1e6 AS \"Pure hydro\", sum(capacity) FILTER (WHERE siec = 'RA120') * 1e6 AS \"Mixed hydro\", sum(capacity) FILTER (WHERE siec = 'RA130') * 1e6 AS \"Pumped hydro\", sum(capacity) FILTER (WHERE siec = 'RA200') * 1e6 AS \"Geothermal\", sum(capacity) FILTER (WHERE siec = 'RA500') * 1e6 AS \"Tide, wave, ocean\", sum(capacity) FILTER (WHERE siec = 'R5100') * 1e6 AS \"Solid biofuels\", sum(capacity) FILTER (WHERE siec = 'R5300') * 1e6 AS \"Biogases\", sum(capacity) FILTER (WHERE siec = 'R5290') * 1e6 AS \"Other liquid biofuels\", sum(capacity) FILTER (WHERE siec = 'W6100') * 1e6 AS \"Industrial waste (non-renewable)\", sum(capacity) FILTER (WHERE siec = 'W6200') * 1e6 AS \"Municipal waste\" FROM eurostat.eurostat WHERE \"geo\\TIME_PERIOD\" = '$Country' AND plant_tec = 'CAP_NET_ELC' GROUP BY year ORDER BY year"
        }
      ],
