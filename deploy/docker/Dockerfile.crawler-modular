# Build context: the repository root (compose.yml sets `context: ..`).
#   docker build -f deploy/docker/Dockerfile.crawler-modular --target runtime .

FROM python:3.13-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# git: uv fetches `oeds` (and the price-forecast pipeline) from Git. Every
# other locked dependency ships a Linux wheel, so no compiler is needed.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Third-party dependencies first (from uv.lock only), so a source change does
# not reinstall them.
COPY pyproject.toml uv.lock README.md ./
COPY packages/crawler-pack/pyproject.toml packages/crawler-pack/README.md packages/crawler-pack/
COPY packages/scheduler/pyproject.toml packages/scheduler/README.md packages/scheduler/
COPY packages/post/pyproject.toml packages/post/README.md packages/post/
RUN uv sync --frozen --no-dev --all-packages --all-extras --no-install-workspace

# Then the three workspace packages, installed as regular (non-editable)
# packages so the runtime stage only needs /app/.venv.
COPY packages/ packages/
RUN uv sync --frozen --no-dev --all-packages --all-extras --no-editable

FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# libeccodes: runtime library for the cfgrib/eccodes GRIB readers.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libeccodes0 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY deploy/CRAWLER_CONFIG.yml ./CRAWLER_CONFIG.yml
COPY packages/crawler-pack/src/crawler/data ./crawler/data

# /app itself must be writable: the admin UI writes CRAWLER_CONFIG.yml.tmp
# next to the bind-mounted config before falling back to an in-place write.
RUN useradd --create-home --shell /bin/bash oeds && \
    mkdir -p /app/logs /var/lib/oeds-admin && \
    chown -R oeds:oeds /app/logs /app/crawler /var/lib/oeds-admin && \
    chown oeds:oeds /app

USER oeds

CMD ["oeds-scheduler", "--config", "/app/CRAWLER_CONFIG.yml", "--daemon"]
