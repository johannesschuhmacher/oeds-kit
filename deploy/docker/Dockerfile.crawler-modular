FROM python:3.13-slim AS core

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_CONSTRAINT=/app/constraints.txt \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libeccodes-dev && \
    rm -rf /var/lib/apt/lists/*

# All third-party dependencies come from the lock file (see
# tools/update_requirements_lock.sh); the module installs below never resolve
# dependencies themselves. Keep this layer before any source so that source
# changes do not reinstall dependencies.
COPY modular_repos/modules/oeds-deployment/docker/constraints.txt ./constraints.txt
COPY modular_repos/modules/oeds-deployment/docker/requirements.lock ./requirements.lock
RUN uv venv /app/.venv --python /usr/local/bin/python && \
    uv pip sync --python /app/.venv/bin/python /app/requirements.lock

COPY modular_repos/sources/oeds-core ./modular_repos/sources/oeds-core
RUN uv pip install --python /app/.venv/bin/python --no-deps \
        -e /app/modular_repos/sources/oeds-core

FROM core AS crawlers
COPY modular_repos/modules/oeds-crawler-pack ./modular_repos/modules/oeds-crawler-pack
RUN uv pip install --python /app/.venv/bin/python --no-deps \
        -e /app/modular_repos/modules/oeds-crawler-pack

FROM crawlers AS post
COPY modular_repos/modules/oeds-post-scripts ./modular_repos/modules/oeds-post-scripts
RUN uv pip install --python /app/.venv/bin/python --no-deps \
        -e /app/modular_repos/modules/oeds-post-scripts

FROM post AS runtime
COPY modular_repos/modules/oeds-scheduler-ui ./modular_repos/modules/oeds-scheduler-ui
RUN uv pip install --python /app/.venv/bin/python --no-deps \
        -e /app/modular_repos/modules/oeds-scheduler-ui

COPY CRAWLER_CONFIG.yml ./CRAWLER_CONFIG.yml
COPY crawler/data ./crawler/data

# /app itself must be writable: the admin UI writes CRAWLER_CONFIG.yml.tmp
# next to the bind-mounted config before falling back to an in-place write.
RUN useradd --create-home --shell /bin/bash oeds && \
    mkdir -p /app/logs /var/lib/oeds-admin && \
    chown -R oeds:oeds /app/logs /app/crawler /var/lib/oeds-admin && \
    chown oeds:oeds /app

USER oeds

CMD ["oeds-scheduler", "--config", "/app/CRAWLER_CONFIG.yml", "--daemon"]
