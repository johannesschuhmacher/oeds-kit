# Eigene API-Schlüssel. Kopie nach ~/.oeds-keys.env, chmod 600, nie committen.
# Laden mit: source ~/.oeds-keys.env
# Nur die Zeilen ausfüllen, für die ihr einen Zugang habt; leere Zeilen löschen.

# ENTSO-E Transparency Platform: Web API und File Library
export ENTSOE_API_KEY=
export ENTSOE_USERNAME=
export ENTSOE_PASSWORD=

# Netztransparenz WebAPI (Extranet, „Meine Clients“)
export NETZTRANSPARENZ_CLIENT_ID=
export NETZTRANSPARENZ_CLIENT_SECRET=

# U.S. EIA Open Data
export EIA_API_KEY=

# GIE AGSI+/ALSI
export GIE_API_KEY=

# Copernicus Climate Data Store
export COPERNICUS_CDS_KEY=
